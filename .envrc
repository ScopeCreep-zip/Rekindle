# Rekindle development environment
# Setup: direnv allow
#
use flake

# ── Host GUI-stack purity ─────────────────────────────────────────────
# Rekindle builds and runs against the HOST webkit2gtk/GTK/GStreamer
# (see the "Nix devshell" note at the bottom — Nix runtime deps were
# deliberately not adopted). Konductor's frontend shell leaks its own
# webkitgtk/gtk/glib/libsoup/gstreamer onto LD_LIBRARY_PATH; loading
# that Nix stack into a host-linked app (and its WebKitWebProcess
# children) mixes two GLib/GStreamer ABIs and aborts the web process
# the moment media initializes:
#   GStreamer:ERROR gst_register_core_elements: code should not be reached
# Drop Nix GUI-stack entries; keep non-Nix entries and the Nix runtime
# deps Rekindle actually wants (REKINDLE_LIB_PATH: sodium/opus/alsa/dbus).
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  _rekindle_filtered=""
  IFS=':' read -ra _rekindle_parts <<<"$LD_LIBRARY_PATH"
  for _p in "${_rekindle_parts[@]}"; do
    case "$_p" in
      /nix/store/*-webkitgtk-*|/nix/store/*-gtk+3-*|/nix/store/*-glib-*|\
      /nix/store/*-gdk-pixbuf-*|/nix/store/*-pango-*|/nix/store/*-cairo-*|\
      /nix/store/*-libsoup-*|/nix/store/*-at-spi2-*|/nix/store/*-librsvg-*|\
      /nix/store/*-libxkbcommon-*|/nix/store/*-libayatana-*|\
      /nix/store/*-gstreamer-*|/nix/store/*-gst-plugins-*|\
      /nix/store/*-graphene-*|/nix/store/*-harfbuzz-*|\
      /nix/store/*-fontconfig-*|/nix/store/*-freetype-*|\
      /nix/store/*-libepoxy-*|/nix/store/*-enchant-*)
        ;;
      *)
        _rekindle_filtered="${_rekindle_filtered:+${_rekindle_filtered}:}${_p}"
        ;;
    esac
  done
  export LD_LIBRARY_PATH="$_rekindle_filtered"
  unset _rekindle_filtered _rekindle_parts _p
fi

# ── Rust toolchain ────────────────────────────────────────────────────
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# ── Build configuration ──────────────────────────────────────────────
export SODIUM_USE_PKG_CONFIG=1

# ── Nix devshell (uncomment to use Nix instead of host deps) ─────────
