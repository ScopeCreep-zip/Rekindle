		<Tile Name="MenuDiv5" X="TabServerText.RIGHT+4" Y="0" Z="9" ResizeX="100" ResizeY="100" Component="MenuDiv5"></Tile>		
		<Tile Name="MenuDiv6" X="TabDownloadText.RIGHT+4" Y="0" Z="9" ResizeX="100" ResizeY="100" Component="MenuDiv6"></Tile>		
