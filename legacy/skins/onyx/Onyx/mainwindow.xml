			<Tile Name="BvBk" ResizeX="100" ResizeY="100" Component="BvBk"></Tile>
		</Tile>
	</Tile>
<!-- BOTTOMBAR BUTTON AREA definition -->	
	<Tile Name="BottomBar" X="5" IndentRight="5" JustY="BOTTOM" Y="51" Z="5" ResizeX="100" ResizeY="100" Component="BottomBar">
	<Tile Name="TabButtonArea" Z="8" JustX="CENTER" Y="0" MinWidth="194" Component="TabButtonArea">		
			<!-- a different row of buttons for each tab -->		
		<Tile Name="FriendsButtons" ResizeX="100" Component="ButtonArea">
		<!-- Tab1 -->
		<!-- 1.1 -->
		  	<Tile Name="AddButton" Component="AddButton" />
		  <!-- 1.2 -->
		  	<Tile Name="ImButton" X="AddButton.RIGHT+2" Component="ImButton" />
		  <!-- 1.3 -->
		  	<Tile Name="JoinFriendButton" X="ImButton.RIGHT+2" Component="JoinButton" />
		  <!-- 1.4 -->
		  	<Tile Name="InfoButton" X="JoinFriendButton.RIGHT+2" Component="InfoButton" />
		 </Tile>
		<Tile Name="ServerButtons" ResizeX="100" Component="ButtonArea">
		<!-- Tab2 -->
		<!-- 2.1 -->
			<Tile Name="AddServerButton" Component="AddServerButton" />
		<!-- 2.2 -->      	
		      	<Tile Name="RefreshButton" X="AddServerButton.RIGHT+2" Component="RefreshButton" />
		<!-- 2.3 -->      	
		      	<Tile Name="JoinServerButton" X="RefreshButton.RIGHT+2" Component="JoinButton" />
		<!-- 2.4 -->      	
		      	<Tile Name="InfoButton" X="JoinServerButton.RIGHT+2" Component="InfoButton" />
		</Tile>
		<Tile Name="FilesButtons" ResizeX="100" Component="ButtonArea">
		<!-- Tab3 -->
		<!-- 3.1 -->
			<Tile Name="StartDownloadButton" Component="StartDownloadButton" />
		<!-- 3.2 -->      	
		      	<Tile Name="StopDownloadButton" X="StartDownloadButton.RIGHT+2" Component="StopDownloadButton" />
		<!-- 3.3 -->      	
		      	<Tile Name="ExecuteDownloadButton" X="StopDownloadButton.RIGHT+2" Component="ExecuteDownloadButton" />
		<!-- 3.4 -->      	
		      	<Tile Name="DownloadInfoButton" X="ExecuteDownloadButton.RIGHT+2" Component="DownloadInfoButton" />
		</Tile>
	</Tile>
