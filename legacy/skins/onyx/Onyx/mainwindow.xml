	<Tile Name="Logo2" X="0" Y="5" Z="4" JustY="BOTTOM" JustX="CENTER" Component="Logo2"></Tile>
<!-- MIDDLE definition -->	
	<Tile Name="LeftEdge" Y="TopLeft.BOTTOM" Z="2" ResizeY="100" ResizeX="0" IndentBottom="BottomLeft.height" Component="LeftEdge"></Tile>
	<Tile Name="RightEdge" Y="TopRight.BOTTOM" Z="2" ResizeY="100" ResizeX="0" JustX="RIGHT" IndentBottom="BottomRight.height" Component="RightEdge"></Tile>
	<Tile Name="Middle" X="83" Y="128" Z="2" IndentRight="83" IndentBottom="117" ResizeX="100" ResizeY="100" Component="Middle"></Tile>
