                    <Tile Name="FindButton" Component="FindButton">
                        <Tile Name="FindButtonText" X="27" Y="4" Component="FindButtonText" />
                    </Tile>
                    <Tile Name="DownloadButton" Y="FindButton.BOTTOM" Component="DownloadButton">
                        <Tile Name="DownloadButtonText" X="27" Y="4" Component="DownloadButtonText" />
                    </Tile>
                    <Tile Name="StopButton" Y="DownloadButton.BOTTOM" Component="StopButton">
                        <Tile Name="StopButtonText" X="27" Y="4" Component="StopButtonText" />
                    </Tile>
                    <Tile Name="ExecuteButton" Y="StopButton.BOTTOM" Component="ExecuteButton">
                        <Tile Name="ExecuteButtonText" X="27" Y="4" Component="ExecuteButtonText" />
                    </Tile>
                </Tile>
            </Tile>

            <Tile Name="InfoJoinChatTab" X="2" Y="TabHeader.BOTTOM+100" Z="49" Component= "ChatTab">
                <Tile Name="HostChatButton" Component="HostChatButton">
