                    <Tile Name="TabDownloadButton" X="0" Y="-4" Z="-4" ResizeX="100" ResizeY="100" OutdentLeft="27" Component="TabDownloadButton" />
                </Tile>
            </Tile>

            <Tile Name="ButtonArea" X="2" Y="TabHeader.BOTTOM+16" MinWidth="110" Component="TabbedControl">
                <Tile Name="FriendsButtons" Component="ButtonRow">
                    <Tile Name="AddFriendButton" Component="AddFriendButton">
                        <Tile Name="AddFriendButtonText" X="27" Y="4" Component="AddFriendButtonText" />
                    </Tile>
                    <Tile Name="ChatButton" Y="AddFriendButton.BOTTOM" Component="ChatButton">
                        <Tile Name="ChatButtonText" X="27" Y="4" Component="ChatButtonText" />
                    </Tile>
                    <Tile Name="GameButton1" Y="ChatButton.BOTTOM" Component="GameButton">
                        <Tile Name="GameButtonText" X="27" Y="4" Component="GameButtonText" />
                    </Tile>
                    <Tile Name="InfoButton1" Y="GameButton1.BOTTOM" Component="InfoButton">
                        <Tile Name="InfoButtonText" X="27" Y="4" Component="InfoButtonText" />
                    </Tile>
                </Tile>

                <Tile Name="ServersButtons" Component="ButtonRow">
                    <Tile Name="AddServerButton" Component="AddServerButton">
                        <Tile Name="AddServerButtonText" X="27" Y="4" Component="AddServerButtonText" />
                    </Tile>
                    <Tile Name="RefreshButton" Y="AddServerButton.BOTTOM" Component="RefreshButton">
                        <Tile Name="RefreshButtonText" X="27" Y="4" Component="RefreshButtonText" />
                    </Tile>
                    <Tile Name="GameButton2" Y="RefreshButton.BOTTOM" Component="GameButton">
                        <Tile Name="GameButtonText" X="27" Y="4" Component="GameButtonText" />
                    </Tile>
                    <Tile Name="InfoButton2" Y="GameButton2.BOTTOM" Component="InfoButton">
                        <Tile Name="InfoButtonText" X="27" Y="4" Component="InfoButtonText" />
                    </Tile>
                </Tile>

