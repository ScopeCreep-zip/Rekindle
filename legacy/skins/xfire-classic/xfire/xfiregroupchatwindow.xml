<Tile Name="XfireGroupChatMainWindow"
	Component="ChatMainWindow"
	>
	<Tile Name="TitleBar"
		IndentLeft="14"
		IndentRight="13+14"
		ResizeX="100"
		ResizeY="0"
		Component="ChatTitleBar"
		>
		<Tile Name="GroupChatVent" JustX="CENTER" Y="5" Component="Vent"></Tile>
		<Tile Name="TheGroupChatX"
			X="23"
			Y="20"
			Component="TheX"
			>
			<Tile Name="TheGroupChatXCover" Component="TheXCover"></Tile>
		</Tile>
		<Tile Name="GroupChatUserNameField"
			X="TheGroupChatX.RIGHT+3"
			Y="TheGroupChatX.TOP+1"
			ResizeX="100"
			IndentRight="66"
			OutdentRight="0"
			Component="UserNameField"
			>
			<Tile Name="GroupChatUserNameText" X="14" Y="0" Component="UserNameText"></Tile>
			<Tile Name="GroupChatWindowTitle" X="GroupChatUserNameText.RIGHT" Y="GroupChatUserNameText.TOP" Component="GroupChatWindowTitle"></Tile>
		</Tile>
		<Tile Name="MinimizeGroupChatBox"
			X="GroupChatUserNameField.RIGHT+1"
			Y="GroupChatUserNameField.TOP"
			Component="MinimizeBox"
			>
		</Tile>
		<Tile Name="CloseGroupChatBox"
			X="MinimizeGroupChatBox.RIGHT+1"
			Y="MinimizeGroupChatBox.TOP"
			Component="CloseChatBox"
			>
		</Tile>
		<Tile Name="ResizeGroupChatUp"
			MinHeight="5"
			ResizeX="100"
			Z="2"
			Component="ResizeUp"
			>
		</Tile>
	</Tile>
	<Tile Name="GroupChatGripperTopLeft"
		Z="6"
		X="0"
		Y="TitleBar.BOTTOM-15"
		Component="GripperTopLeft"
		>
	</Tile>
	<Tile Name="GroupChatGripperTopRight"
		Z="6"
		X="13"
		JustX="RIGHT"
		Y="TitleBar.BOTTOM-15"
		Component="GripperTopRight"
		>
	</Tile>
	<Tile Name="GroupChatBaseBoard"
		Z="4"
		X="0"
		Y="0"
		JustY="BOTTOM"
		ResizeX="100"
		ResizeY="0"
		IndentLeft="13"
		IndentRight="10+16"
		Component="ChatBaseBoard"
		>
		<Tile Name="GroupSendButton" JustX="RIGHT" X="25" Y="8" Component="GroupSendButton"></Tile>
		<Tile Name="ResizeDown" JustY="BOTTOM" ResizeX="100" Z="2" Component="ResizeDown"></Tile>
		<Tile Name="TypingMessage"
			X="45"
			Y="8"
			IndentRight="GroupSendButton.width+30"
			Component="TypingMessage"
			>
		</Tile>
	</Tile>
	<Tile Name="ChatLeftOuterEdge"
		Z="4"
		X="0"
		Y="GroupChatGripperTopLeft.BOTTOM-16"
		ResizeX="0"
		ResizeY="100"
		IndentBottom="GroupChatBaseBoard.height+14"
		Component="ChatLeftOuterEdge"
		>
	</Tile>
	<Tile Name="ChatRightOuterEdge"
		Z="4"
		X="13"
		Y="GroupChatGripperTopRight.BOTTOM-16"
		JustX="RIGHT"
		ResizeX="0"
		ResizeY="100"
		IndentBottom="GroupChatBaseBoard.height+14"
		Component="ChatRightOuterEdge"
		>
	</Tile>
	<Tile Name="GroupChatGripperBottomLeft"
		Z="5"
		X="0"
		Y="ChatLeftOuterEdge.BOTTOM-17"
		Component="ChatGripperBottomLeft"
		>
	</Tile>
	<Tile Name="GroupChatGripperBottomRight"
		Z="5"
		X="13"
		Y="ChatRightOuterEdge.BOTTOM-17"
		JustX="RIGHT"
		Component="ChatGripperBottomRight"
		>
	</Tile>
	<Tile Name="GroupChatInnerBevel"
		Z="-1"
		X="ChatLeftOuterEdge.RIGHT"
		Y="TitleBar.BOTTOM-6"
		ResizeX="100"
		ResizeY="100"
		IndentRight="ChatRightOuterEdge.width+13"
		IndentBottom="GroupChatBaseBoard.height-2"
		Component="InnerBevel"
		>
		<Tile Name="TopBevel" ResizeX="100" ResizeY="0" Component="TopBevel"></Tile>
		<Tile Name="BottomBevel" JustY="BOTTOM" ResizeX="100" ResizeY="0" Component="BottomBevel"></Tile>
		<Tile Name="MiddleBevel"
			Y="TopBevel.BOTTOM"
			ResizeX="100"
			ResizeY="100"
			IndentBottom="BottomBevel.height"
			Component="MiddleBevel"
			>
		</Tile>
		<Tile Name="MenuBar"
			ResizeX="100"
			X="7"
			IndentRight="6"
			Y="8"
			Component="MenuBar"
			>
			<Tile Name="SystemMenuText"
				X="33"
				Y="3"
				Z="10"
				Component="SystemMenuText"
				>
				<Tile Name="GCSystemMenu"
					X="0"
					Y="0"
					Z="-2"
					ResizeX="100"
					ResizeY="100"
					OutdentLeft="2"
					OutdentRight="2"
					OutdentTop="3"
					OutdentBottom="1"
					Component="GCSystemMenu"
					>
				</Tile>
			</Tile>
			<Tile Name="ActionsMenuText"
				X="SystemMenuText.RIGHT+10"
				Y="3"
				Z="10"
				Component="ActionsMenuText"
				>
				<Tile Name="GCActionsMenu"
					X="0"
					Y="0"
					Z="-2"
					ResizeX="100"
					ResizeY="100"
					OutdentLeft="2"
					OutdentRight="2"
					OutdentTop="3"
					OutdentBottom="1"
					Component="GCActionsMenu"
					>
				</Tile>
			</Tile>
			<Tile Name="GCHelpMenuText"
				X="ActionsMenuText.RIGHT+10"
				Y="3"
				Z="10"
				Component="GCHelpMenuText"
				>
				<Tile Name="GCHelpMenu"
					X="0"
					Y="0"
					Z="-2"
					ResizeX="100"
					ResizeY="100"
					OutdentLeft="2"
					OutdentRight="2"
					OutdentTop="3"
					OutdentBottom="1"
					Component="GCHelpMenu"
					>
				</Tile>
			</Tile>
		</Tile>
		<Tile Name="InnerBevelBG" Z="-1" ResizeX="100" ResizeY="100" Component="InnerBevelBG"></Tile>
		<Tile Name="GroupChatArea"
			X="16"
			IndentRight="16"
			Y="30"
			IndentBottom="19+20"
			ResizeX="100"
			ResizeY="80"
			Component="GroupChatArea"
			>
		</Tile>
		<Tile Name="Divider"
			Z="2"
			X="6"
			IndentRight="5"
			Y="GroupChatArea.BOTTOM"
			ResizeX="100"
			Component="Divider"
			>
		</Tile>
		<Tile Name="GroupChatEdit"
			X="16"
			IndentRight="16"
			Y="Divider.BOTTOM+3"
			ResizeX="100"
			ResizeY="100"
			IndentBottom="19"
			Component="GroupChatEdit"
			>
		</Tile>
	</Tile>
	<Tile Name="InfoViewButton"
		JustY="CENTER"
		X="ChatRightOuterEdge.RIGHT"
		Component="GroupChatInfoViewButton"
		>
	</Tile>
</Tile>
