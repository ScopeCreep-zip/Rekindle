<!-- VoiceWindow Overlay -->
<!-- ControlId Range: 500-599 -->
<Overlay>
  <Tile Name="VoiceWindow" ResizeX="100" ResizeY="100" Features="VoiceChat" Component="XIGVoice">

    <Tile Name="VoiceWindowToggle"
          ResizeX="100"
          ResizeY="100"
          ControlId="501"
          AttachedControlId="501"
          Component="XIGWindowToggle"
          >
      <Tile Name="VoiceWindowActive"
            ResizeX="100"
            ResizeY="100"
            Component="XIGWindowToggleActive">
        <Tile Name="ActiveVoiceContainer"
              ResizeX="100"
              ResizeY="100"
              Component="XIGAlertContainer">
          <Tile Name="ActiveVoiceOutline"
                ResizeX="100"
                ResizeY="100"
                Component="XIGAlertOutline">
          </Tile>
          <Tile Name="ActiveVoiceContainerOuter"
                ResizeX="100"
                ResizeY="100"
                Component="XIGAlertContainerOuter">
          </Tile>
          <Tile Name="ActiveVoiceContainerGrippers"
                ResizeX="100"
                ResizeY="100"
                Z="20"
                Component="XIGAlertContainerGrippers">
          </Tile>

          <Tile Name="ActiveTitleBG"
                Z="30"
                Y="8"
                IndentLeft="8"
                IndentRight="8"
                ResizeX="100"
                Component="XIGActiveTitleBG">
            <Tile Name="VoiceChatTitle"
                  X="5"
                  ResizeX="100"
                  ResizeY="100"
                  IndentTop="5"
                  IndentRight="30"
                  Component="XIGVoiceChatTitle">
            </Tile>
            <Tile Name="VoiceClose"
                  X="4"
                  Y="4"
                  JustX="RIGHT"
                  ControlId="550"
                  Component="XIGCloseVoiceBox"
                  TabOrder="50">
            </Tile>
          </Tile>
          <!-- End ActiveTitleBG -->

          <Tile Name="VoiceContainerBG"
                ResizeX="100"
                ResizeY="100"
                IndentLeft="5"
                IndentRight="5"
                IndentBottom="5"
                IndentTop="32"
                Z="-1"
                Component="BvBk">
          </Tile>

          <Tile Name="OpacitySlider"
                JustY="BOTTOM"
                JustX="RIGHT"
                X="36"
                Y="16"
                MinWidth="60"
                Component="XIGOpacitySlider"
                TabOrder="40"
                ControlId="540"
                FocusedColor="XIGFocusedRectColor">
            <Tile Name="OpacityTrack"
                  ResizeX="100"
                  Stretch="ToContent"
                  Component="XIGSliderTrack">
            </Tile>
            <Tile Name="OpacityGripper"
                  ResizeY="100"
                  Stretch="ToContent"
                  Component="XIGSliderGripper">
            </Tile>
          </Tile>

          <Tile Name="CallReflectorButton"
                JustY="BOTTOM"
                Y="11"
                X="11"
                Z="20"
                ControlId="530"
                TabOrder="30"
                Component="XIGCallReflectorButtonOverlay"
                FocusedColor="XIGFocusedRectColor">
            <Tile Name="CallIcon"
                  JustX="LEFT"
                  JustY="CENTER"
                  Component="XIGCallIcon"
                  CallState="Call">
            </Tile>
            <Tile Name="CallRingingIcon"
                  JustX="LEFT"
                  JustY="CENTER"
                  Component="XIGCallRingingIcon"
                  CallState="Ringing">
            </Tile>
            <Tile Name="CallConnectedIcon"
                  JustX="LEFT"
                  JustY="CENTER"
                  Component="XIGCallConnectedIcon"
                  CallState="Connected">
            </Tile>
            <Tile Name="CallTalkingIcon"
                  JustX="LEFT"
                  JustY="CENTER"
                  Component="XIGCallTalkingIcon"
                  CallState="Talking">
            </Tile>
            <Tile Name="CallDisabledIcon"
                  JustX="LEFT"
                  JustY="CENTER"
                  Component="XIGCallDisabledIcon"
                  CallState="Disabled">
            </Tile>
          </Tile>

          <Tile Name="PushToTalkState"
                JustY="BOTTOM"
                Y="33"
                ResizeX="100"
                ControlId="528"
                AttachedControlId="528"
                Component="XIGPushToTalkState">
            <Tile Name="PushToTalkOff"
                  ResizeX="100"
                  Component="XIGPushToTalkOff">
              <Tile Name="MicSensitivitySlider"
                    ResizeX="100"
                    IndentLeft="15"
                    IndentRight="35"
                    ControlId="529"
                    TabOrder="29"
                    FocusedColor="XIGFocusedRectColor"
                    Component="XIGMicSensitivitySlider">
                <Tile Name="MicSensitivityTrack"
                      ResizeX="100"
                      Stretch="ToContent"
                      Component="XIGSliderTrack">
                </Tile>
                <Tile Name="MicSensitivityGripper"
                      ResizeY="100"
                      Stretch="ToContent"
                      Component="XIGSliderGripper">
                </Tile>
              </Tile>

              <Tile Name="MicSensitivityIcon"
                    JustX="RIGHT"
                    X="13"
                    Component="XIGMicSensitivityIcon"
            >
              </Tile>
            </Tile>
            <!-- END PushToTalkOff -->

            <Tile Name="PushToTalkOn"
                  ResizeX="100"
                  IndentLeft="15"
                  IndentRight="35"
                  Component="XIGPushToTalkOn">
              <Tile Name="PushToTalkOnText"
                    Component="XIGPushTalkOnText">
              </Tile>
            </Tile>
            <!-- END PushToTalkOn -->

          </Tile>
          <!-- PushToTalkState -->

          <Tile Name="MicSlider"
                Y="PushToTalkState.TOP - 18"
                ResizeX="100"
                IndentLeft="15"
                IndentRight="35"
                ControlId="520"
                TabOrder="20"
                FocusedColor="XIGFocusedRectColor"
                Component="XIGMicSlider">
            <Tile Name="MicTrack"
                  ResizeX="100"
                  Stretch="ToContent"
                  Component="XIGSliderTrack">
            </Tile>
            <Tile Name="MicGripper"
                  ResizeY="100"
                  Stretch="ToContent"
                  Component="XIGSliderGripper">
            </Tile>
          </Tile>

          <Tile Name="MicIcon"
                JustX="RIGHT"
                X="13"
                Y="MicSlider.TOP"
                Component="XIGMicStateOff">
          </Tile>

          <Tile Name="SpeakerSlider"
                Y="MicSlider.TOP - 18"
                ResizeX="100"
                IndentLeft="15"
                IndentRight="35"
                ControlId="510"
                TabOrder="10"
                FocusedColor="XIGFocusedRectColor"
                Component="XIGSpeakerSlider"
                Default="SetFocusControl">
            <Tile Name="SpeakerTrack"
                  ResizeX="100"
                  Stretch="ToContent"
                  Component="XIGSliderTrack">
            </Tile>
            <Tile Name="SpeakerGripper"
                  ResizeY="100"
                  Stretch="ToContent"
                  Component="XIGSliderGripper">
            </Tile>
          </Tile>

          <Tile Name="SpeakerIcon"
                JustX="RIGHT"
                X="13"
                Y="SpeakerSlider.TOP"
                Component="XIGSpeakerStateOff">
          </Tile>

          <Tile Name="ActiveVoiceControl"
                ResizeX="100"
                ResizeY="100"
                IndentTop="36"
                IndentBottom="75"
                IndentLeft="12"
                IndentRight="12"
                Z="100"
                Component="XIGActiveVoiceControl">
          </Tile>
        </Tile>
        <!-- End ActiveVoiceContainer -->

        <Tile Name="BRResizeZone"
              JustX="RIGHT"
              JustY="BOTTOM"
              Component="XIGBRResizeZone"
              Z="25"
          >
        </Tile>

        <Tile Name="BLResizeZone"
              JustY="BOTTOM"
              Component="XIGBLResizeZone"
              Z="25"
          >
        </Tile>

        <Tile Name="RightResizeZone"
              JustX="RIGHT"
              Z="20"
              ResizeY="100"
              Component="XIGRightResizeZone"
          >
        </Tile>

        <Tile Name="LeftResizeZone"
              ResizeY="100"
              Z="20"
              Component="XIGLeftResizeZone"
          >
        </Tile>

        <Tile Name="TopResizeZone"
              JustY="TOP"
              ResizeX="100"
              Z="20"
              Component="XIGTopResizeZone"
          >
        </Tile>

        <Tile Name="BottomResizeZone"
              JustY="BOTTOM"
              ResizeX="100"
              Z="20"
              Component="XIGBottomResizeZone"
          >
        </Tile>
      </Tile>
      
      <Tile Name="VoiceWindowInActive"
            ResizeX="100"
            ResizeY="100"
            Component="XIGWindowToggleInActive">
        <Tile Name="InActiveVoiceControl"
              ResizeX="100"
              ResizeY="100"
              IndentTop="3"
              IndentBottom="3"
              IndentLeft="3"
              IndentRight="3"
              Z="100"
              Component="XIGActiveVoiceControl">
        </Tile>
      </Tile>
      
    </Tile>

  </Tile>
</Overlay>