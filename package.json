{
  "name": "rekindle",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "dev": "lsof -ti:1430 | xargs kill -9 2>/dev/null; vite",
    "dev:mac": "./scripts/mac-dev-app.sh",
    "dev:linux": "./scripts/linux-dev.sh",
    "reset:veilid": "./scripts/reset-veilid-storage.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle": "tauri build --config src-tauri/tauri.release.conf.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json && tsc -p tsconfig.node.json",
    "test:mock": "playwright test --project=mock",
    "test:layout": "playwright test --project=layout",
    "test:a11y": "playwright test --project=a11y",
    "test:security": "playwright test --config playwright.security.config.ts",
    "test:e2e": "E2E=true playwright test --project=e2e",
    "test:e2e:headed": "E2E=true playwright test --project=e2e --headed",
    "test:e2e:ui": "E2E=true playwright test --project=e2e --ui",
    "test:all": "playwright test --project=mock && E2E=true playwright test --project=e2e",
    "walk": "node e2e/walk/node-check.mjs && node e2e/walk/walk.ts"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@tauri-apps/api": "^2.12.1",
    "qr-scanner": "^1.4.2",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.5.0",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.39.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.0.0",
    "webdriverio": "10.1.0"
  }
}
