{
  "name": "rekindle",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lsof -ti:1430 | xargs kill -9 2>/dev/null; vite",
    "dev:mac": "./scripts/mac-dev-app.sh",
    "dev:linux": "./scripts/linux-dev.sh",
    "reset:veilid": "./scripts/reset-veilid-storage.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json && tsc -p tsconfig.node.json",
    "test:mock": "playwright test --project=mock",
    "test:security": "playwright test --config playwright.security.config.ts",
    "test:e2e": "E2E=true playwright test --project=e2e",
    "test:e2e:headed": "E2E=true playwright test --project=e2e --headed",
    "test:e2e:ui": "E2E=true playwright test --project=e2e --ui",
    "test:all": "playwright test --project=mock && E2E=true playwright test --project=e2e"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@tauri-apps/api": "^2.12.2",
    "qr-scanner": "^1.4.2",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.5.0",
    "knip": "^6.41.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
