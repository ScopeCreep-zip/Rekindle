// Type-checks the Playwright suites and their fixtures.
//
// e2e/ was outside every tsconfig `include`, so nothing type-checked it.
// That let e2e/security/xss.spec.ts call setupMocks() with an object
// literal where the signature takes a string — a bug that made the
// handler unusable and went unnoticed because the suite also never ran
// in CI. Both gaps are closed: this config, and the `security` job in
// lint.yml.
//
// Kept separate from tsconfig.json so `pnpm build` (tsc && vite build)
// stays scoped to shipped app code; run via `pnpm typecheck`.
//
// Scope is e2e/** only. The playwright.*.config.ts files read
// `process.env` and are covered by tsconfig.node.json, which carries
// @types/node. That judgement was revisited when the shared
// playwright.base.config.ts was extracted: three config files with real
// logic in them is past the point where "Playwright executes them
// anyway" covers it, and keeping `node` types in a separate project
// means they never reach src/**.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The app config narrows `types` to vite/client, which would hide
    // Playwright's globals here.
    "types": ["@playwright/test"],
    "noEmit": true
  },
  "include": ["e2e/**/*.ts"]
}
