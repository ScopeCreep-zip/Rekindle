    "buddy-list"
  ],
  "permissions": [
    "allow-open-external-url",
    "allow-accept-dm-invite",
    "allow-accept-request",
    "allow-add-friend",
    "allow-add-friend-from-invite",
    "allow-block-user",
    "allow-cancel-invite",
    "allow-cancel-request",
    "allow-create-community",
    "allow-create-friend-group",
    "allow-decline-dm-invite",
    "allow-emit-friends-presence",
    "allow-friendship-scan-now",
    "allow-generate-invite",
    "allow-get-communities",
    "allow-get-game-status",
    "allow-get-network-status",
    "allow-get-outgoing-invites",
    "allow-get-pending-requests",
    "allow-get-unread-counts",
    "allow-join-community",
    "allow-get-pending-deep-link",
    "allow-confirm-deep-link",
    "allow-dismiss-deep-link",
    "allow-launch-game-to-server",
    "allow-list-dms",
    "allow-list-received-relay-offers",
    "allow-list-volunteered-relay-friends",
    "allow-logout",
    "allow-move-friend-to-group",
    "allow-open-chat-window",
    "allow-open-community-window",
    "allow-open-dm-window",
    "allow-open-profile-window",
    "allow-open-settings-window",
    "allow-reject-request",
    "allow-remove-friend",
    "allow-rename-friend-group",
    "allow-reset-signal-session",
    "allow-revoke-relay",
    "allow-set-friend-nickname",
    "allow-set-nickname",
    "allow-set-status",
    "allow-set-status-message",
    "allow-start-dm",
    "allow-start-dm-call",
    "allow-start-group-call",
    "allow-update-community-presence",
    "allow-volunteer-relay",
    "allow-accept-dm-call",
    "allow-decline-dm-call",
    "allow-end-dm-call",
    "allow-accept-group-call",
    "allow-decline-group-call",
    "allow-end-group-call",
    "allow-get-missed-calls",
