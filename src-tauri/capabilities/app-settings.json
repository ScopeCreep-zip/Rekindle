{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-settings",
  "description": "App-command grants for the `settings` window: preferences, notifications/DND/quiet-hours, audio/video device selection, blocked users, strand-relay management, cross-device pairing/sync, mobile push-relay registration, update checks, and identity audit-log verify/export.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-accept-pairing-code",
    "allow-audit-export",
    "allow-audit-verify",
    "allow-check-for-updates",
    "allow-ensure-personal-sync-record",
    "allow-generate-pairing-qr-svg",
    "allow-get-blocked-users",
    "allow-get-do-not-disturb",
    "allow-get-link-previews-enabled",
    "allow-get-preferences",
    "allow-get-quiet-hours",
    "allow-list-audio-devices",
    "allow-list-native-video-devices",
    "allow-list-push-relay-registrations",
    "allow-list-received-relay-offers",
    "allow-list-volunteered-relay-friends",
    "allow-native-video-active",
    "allow-read-paired-devices",
    "allow-read-sync-manifest",
    "allow-read-sync-preferences",
    "allow-read-sync-read-state",
    "allow-register-with-push-relay",
    "allow-report-media-capture-error",
    "allow-revoke-relay",
    "allow-run-background-sync",
    "allow-set-audio-devices",
    "allow-set-avatar",
    "allow-set-do-not-disturb",
    "allow-set-input-channels",
    "allow-set-link-previews-enabled",
    "allow-set-nickname",
    "allow-set-preferences",
    "allow-set-quiet-hours",
    "allow-set-status-message",
    "allow-start-pairing-session",
    "allow-unblock-user",
    "allow-unregister-with-push-relay",
    "allow-volunteer-relay",
    "allow-write-paired-devices",
    "allow-write-sync-manifest",
    "allow-write-sync-preferences",
    "allow-write-sync-read-state"
  ]
}
