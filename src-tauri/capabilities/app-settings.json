{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-settings",
  "description": "App-command grants for the `settings` window: preferences, notifications/DND/quiet-hours, audio/video device selection, blocked users, strand-relay management, cross-device pairing/sync, mobile push-relay registration, update checks, our game-time totals and bio for Settings → Profile, the game-sharing switches and hide list of Settings → Privacy, the game-detection switch of Settings → Application, and identity audit-log verify/export, and the skins of Settings → Appearance (list, import, remove, select, keep, login skin, and opening the skin editor) with a skin's credited source opened through `open_external_url` (it asks in Rust before it opens).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-accept-pairing-code",
    "allow-audit-export",
    "allow-audit-verify",
    "allow-check-for-updates",
    "allow-ensure-personal-sync-record",
    "allow-import-skin",
    "allow-keep-skin",
    "allow-generate-pairing-qr-svg",
    "allow-get-blocked-users",
    "allow-get-do-not-disturb",
    "allow-get-game-totals",
    "allow-get-link-previews-enabled",
    "allow-get-preferences",
    "allow-get-quiet-hours",
    "allow-list-audio-devices",
    "allow-list-native-video-devices",
    "allow-list-push-relay-registrations",
    "allow-list-received-relay-offers",
    "allow-list-skins",
    "allow-list-volunteered-relay-friends",
    "allow-native-video-active",
    "allow-native-video-capture-available",
    "allow-open-external-url",
    "allow-open-skin-editor-window",
    "allow-read-paired-devices",
    "allow-read-sync-manifest",
    "allow-read-sync-preferences",
    "allow-register-with-push-relay",
    "allow-remove-skin",
    "allow-report-media-capture-error",
    "allow-revoke-relay",
    "allow-run-background-sync",
    "allow-select-skin",
    "allow-set-audio-devices",
    "allow-set-avatar",
    "allow-set-do-not-disturb",
    "allow-set-input-channels",
    "allow-set-link-previews-enabled",
    "allow-set-login-skin",
    "allow-set-nickname",
    "allow-set-preferences",
    "allow-set-read-receipts-enabled",
    "allow-set-quiet-hours",
    "allow-set-share-game-totals",
    "allow-quick-wipe-arm",
    "allow-quick-wipe-disarm",
    "allow-set-status-message",
    "allow-set-video-device",
    "allow-start-pairing-session",
    "allow-unblock-user",
    "allow-unregister-with-push-relay",
    "allow-volunteer-relay",
    "allow-write-paired-devices",
    "allow-write-sync-manifest",
    "allow-write-sync-preferences",
    "allow-get-bio",
    "allow-set-bio",
    "allow-get-hidden-games",
    "allow-hide-game",
    "allow-get-favourite-servers",
    "allow-add-favourite-server",
    "allow-remove-favourite-server",
    "allow-unhide-game",
    "allow-set-share-current-game",
    "allow-set-game-detection"
  ]
}
